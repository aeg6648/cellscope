# Otari service key (otk_...). Service keys accept the per-request "user" field, so Otari per-end-user budgets apply.
OTARI_API_KEY=
OTARI_BASE_URL=https://otari.ai/api/v1
# Otari routing policy name used for the researcher + MCP roles (dashboard: Routing, fallback chain)
OTARI_ROUTE_ALIAS=cellscope-researcher
# Workspace MCP server id(s) for DeepWiki (comma separated). Empty -> inline mcp_servers config is sent instead.
OTARI_MCP_SERVER_IDS=
# ids (default) or inline
CELLSCOPE_MCP_MODE=ids
# Otari guardrail profile sent as request-level guardrails on every call
OTARI_GUARDRAIL_PROFILE=cellscope-safety
# CellScope app-side soft cap per end user (USD), computed from usage.cost_usd
CELLSCOPE_USER_BUDGET_USD=0.25
CELLSCOPE_USAGE_FILE=.cellscope_usage.json
# 1 = send "user" (needs a service key); auto-disabled if the gateway rejects it
CELLSCOPE_SEND_USER_FIELD=1
